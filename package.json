{
  "name": "inviso-new",
  "version": "1.0.0",
  "description": "A cross-platform tool for designing interactive virtual soundscapes. <br/> Accessible online at: <a link href=\"http://inviso.cc\">inviso.cc</a>",
  "author": "CreativeCodingLab",
  "main": "app.js",
  "scripts": {
    "dev": "run-p dev:sass webpack-dev",
    "webpack-dev": "webpack serve --mode development",
    "dev:sass": "sass --watch src/css:src/public/assets/css",
    "build": "run-s clean build:dir build:js build:sass",
    "clean": "rimraf build",
    "deploy": "gh-pages -d build/public",
    "lint": "eslint src/js/",
    "build:dir": "copyfiles -u 1 \"src/public/**/*\" build/",
    "build:sass": "sass src/css:build/public/assets/css --style=compressed",
    "build:js": "webpack --mode production"
  },
  "dependencies": {
    "@google-cloud/storage": "^5.20.5",
    "ambisonics": "^0.4.0",
    "es6-promise": "^4.2.8",
    "firebase": "^12.6.0",
    "regenerator-runtime": "^0.13.11",
    "three": "^0.142.0",
    "three-obj-loader": "^1.1.3",
    "three-stdlib": "^2.36.1",
    "tween.js": "^16.6.0",
    "whatwg-fetch": "^2.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-loader": "^10.0.0",
    "copyfiles": "^1.2.0",
    "css-loader": "^6.10.0",
    "eslint": "^3.19.0",
    "eslint-config-airbnb-base": "^11.3.2",
    "eslint-plugin-import": "^2.31.0",
    "gh-pages": "^6.3.0",
    "npm-run-all": "^3.0.0",
    "rimraf": "^2.7.1",
    "sass": "^1.94.0",
    "sass-loader": "^16.0.6",
    "style-loader": "^3.3.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "engines": {
    "node": ">=8.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilcamci/inviso-new.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anilcamci/inviso-new/issues"
  },
  "homepage": "https://github.com/anilcamci/inviso-new#readme"
}
